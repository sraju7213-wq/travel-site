{
  "name": "ks-world-adventure-site",
  "version": "0.1.0",
  "private": true,
  "description": "KS World Adventure travel site (Next.js app lives in ./app)",
  "scripts": {
    "install": "npm --prefix app install",
    "install:app": "npm --prefix app install",
    "dev": "npm --prefix app run dev",
    "build": "npm --prefix app install && npm --prefix app run build",
    "start": "npm --prefix app run start",
    "lint": "npm --prefix app run lint",
    "typecheck": "npm --prefix app run typecheck",
    "clean": "node -e \"const fs=require('fs');for(const p of ['app/.next','app/tsconfig.tsbuildinfo'])fs.rmSync(p,{recursive:true,force:true})\"",
    "audit:a11y": "node app/scripts/a11y_audit.mjs",
    "audit:mobile": "node app/scripts/mobile_audit.mjs",
    "check:contrast": "node app/scripts/contrast.mjs"
  }
}
